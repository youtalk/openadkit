[Unit]
Description=X5H OTA: judge the update after a boot (x5h-ota verify)
ConditionKernelCommandLine=x5h.role=demo
ConditionPathExists=/var/lib/x5h-ota/pending
# x5h-demo-up.sh starts x5h-si-link and score-lm itself, so order after it.
After=x5h-demo.service
# The CR52 slot is on UFS0. On some boots Linux fails the UFS0 link startup.
# Then the check cannot see the slot, so it does not run, and the next boot
# judges the update.
Requires=dev-disk-by\x2dpath-platform\x2dc0a80000.ufs\x2dscsi\x2d0:0:0:0.device
After=dev-disk-by\x2dpath-platform\x2dc0a80000.ufs\x2dscsi\x2d0:0:0:0.device

[Service]
Type=oneshot
ExecStart=/usr/sbin/x5h-ota verify
# Two judgments of 120 s, two launch manager stops of 15 s, and margin.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
