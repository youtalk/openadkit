# QEMU-gate hardware fragment — deliberately compiled into the BOARD image
# too (the one-image property: the gate boots the byte-identical Image the
# board netboots; the cost is a few hundred KB of harmless drivers). Almost
# everything here is already =y in x5h-board.config because the BSP config
# is Yocto-derived; the fragment exists so the gate's hardware needs are
# declared and asserted rather than inherited by luck.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_PCI_HOST_GENERIC=y
