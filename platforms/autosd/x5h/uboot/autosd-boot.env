# bootcmd_autosd — boots the BSP kernel with the AutoSD NFS root.
# Template only: fill ${...} site values from x5h-work/HANDOFF.md at the U-Boot
# prompt. The default bootcmd is never modified; run with: run bootcmd_autosd
# Identical to the working BSP netboot flow except nfsroot points at the AutoSD
# export and selinux=0 is appended (AutoSD userspace, no SELinux in this kernel).
setenv autosd_nfsroot ${serverip}:${autosd_export_path}
setenv bootargs_autosd "${bootargs_bsp} root=/dev/nfs rw nfsroot=${autosd_nfsroot},vers=3,tcp ip=${board_ip_config} selinux=0"
setenv bootcmd_autosd 'tftp ${kernel_addr_r} Image; tftp ${fdt_addr_r} ${dtb_file}; setenv bootargs ${bootargs_autosd}; booti ${kernel_addr_r} - ${fdt_addr_r}'
